<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Android 布局实验"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_linear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. 线性布局实验"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_table"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. 表格布局实验"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_constraint1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. 约束布局1 — 计算器"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_constraint2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="4. 约束布局2 — 仪表盘"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_compose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5. Compose 实验 — 任务列表" />

</LinearLayout>
